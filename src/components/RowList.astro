---
import type { Row } from "../lib/content";

interface Props {
  rows: Row[];
  noIcon?: boolean;
}

const { rows, noIcon = false } = Astro.props;
---

<div class="row-list">
  {
    rows.map((r) => {
      const Element = r.href ? "a" : "div";
      return (
        <Element href={r.href} class:list={["row", { "no-icon": noIcon }]}>
          {!noIcon && <span class="row-icon" aria-hidden="true">{r.icon ?? "·"}</span>}
          <span class="row-title">
            {r.title}
            {r.sub && <span class="row-sub">{r.sub}</span>}
          </span>
          {r.end && <span class="row-end">{r.end}</span>}
        </Element>
      );
    })
  }
</div>
