---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../site.config";
import { getCertifications, getEducation, getSkills, getTimeline } from "../lib/content";

const [timeline, education, certifications, skills] = await Promise.all([
  getTimeline(),
  getEducation(),
  getCertifications(),
  getSkills(),
]);
---

<Base title={`About — ${SITE.name}`}>
  <Header intro={SITE.intro.about} />

  <section>
    <h2>timeline</h2>
    <ol class="timeline">
      {timeline.map((t) => (
        <li class="t-row">
          <div class="t-year">{t.when}</div>
          <div class="t-event">{t.event}</div>
        </li>
      ))}
    </ol>
  </section>

  <section>
    <h2>education</h2>
    <ol class="timeline">
      {education.map((e) => (
        <li class="t-row">
          <div class="t-year">{e.when}</div>
          <div class="t-event"><strong>{e.school}</strong> · {e.credential}</div>
        </li>
      ))}
    </ol>
  </section>

  <section>
    <h2>certifications</h2>
    <ul class="certs">
      {certifications.map((c) => (
        <li><span class="c-year">{c.year}</span> {c.title}</li>
      ))}
    </ul>
  </section>

  <section>
    <h2>stack</h2>
    <ul class="stack">
      {skills.map((s) => <li>{s}</li>)}
    </ul>
  </section>

  <Footer />
</Base>

<style>
  .timeline { list-style: none; display: flex; flex-direction: column; }
  .t-row {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 18px;
    padding: 14px 0;
    border-bottom: 1px solid var(--faint);
    align-items: baseline;
  }
  .t-year {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
  }
  .t-event { font-size: 15.5px; line-height: 1.55; }
  .t-event strong { font-weight: 500; }

  .certs {
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .certs li {
    padding: 10px 0;
    border-bottom: 1px solid var(--faint);
    font-size: 15px;
    display: flex;
    gap: 18px;
    align-items: baseline;
  }
  .c-year {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    min-width: 60px;
  }

  .stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .stack li {
    font-family: var(--font-mono);
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    border: 1px solid var(--faint);
    padding: 4px 10px;
    border-radius: 999px;
  }

  @media (max-width: 520px) {
    .t-row { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
