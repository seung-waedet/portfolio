---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import RowList from "../components/RowList.astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { SITE } from "../site.config";
import { ICON_PROPS } from "../lib/icons";
import { getProjects, projectRow } from "../lib/content";

const buildingRows = (await getProjects({ featuredOnly: true })).map(projectRow);
---

<Base title={`${SITE.name} — software developer`}>
  <Header intro={SITE.intro.home} />

  <section>
    <h2>building</h2>
    <RowList rows={buildingRows} />
    <p class="more"><a href="/projects" class="icon-link">all projects <ArrowRight {...ICON_PROPS.inline} /></a></p>
  </section>

  <Footer />
</Base>

<style>
  .more {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .more a { color: var(--muted); }
  .more a:hover { color: var(--accent); }
</style>
