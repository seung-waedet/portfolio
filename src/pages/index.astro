---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import RowList from "../components/RowList.astro";
import { SITE } from "../site.config";
import { getProjects, projectRow } from "../lib/content";

const projectRows = (await getProjects()).map(projectRow);
---

<Base>
  <Header intro={SITE.intro.home} />

  <section>
    <h2>how I work</h2>
    <p class="how">{SITE.howIWork}</p>
  </section>

  <section>
    <h2>projects</h2>
    <RowList rows={projectRows} />
  </section>

  <Footer />
</Base>

<style>
  .how {
    font-size: 16.5px;
    max-width: 560px;
  }
</style>
