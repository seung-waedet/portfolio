---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import RowList from "../components/RowList.astro";
import { SITE } from "../site.config";
import { getProjects, getWorkRows, projectRow } from "../lib/content";

const buildingRows = (await getProjects({ featuredOnly: true })).map(projectRow);
// Home shows the three most recent roles; the full history lives on /about.
const workRows = await getWorkRows({ limit: 3, stackLimit: 2 });
---

<Base title={`${SITE.name} — software developer`}>
  <Header intro={SITE.intro.home} />

  <section>
    <h2>building</h2>
    <RowList rows={buildingRows} />
    <p class="more"><a href="/projects">all projects →</a></p>
  </section>

  <section>
    <h2>work</h2>
    <RowList rows={workRows} />
    <p class="more"><a href="/about">full history →</a></p>
  </section>

  <Footer />
</Base>

<style>
  .more {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .more a { color: var(--muted); }
  .more a:hover { color: var(--accent); }
</style>
