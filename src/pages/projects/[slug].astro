---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Footer from "../../components/Footer.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { SITE } from "../../site.config";
import { ICON_PROPS } from "../../lib/icons";
import { getProjects } from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<Base title={`${data.title} — ${SITE.name}`} description={data.tagline}>
  <div class="topbar">
    <a class="back icon-link" href="/projects"><ArrowLeft {...ICON_PROPS.inline} /> all projects</a>
    <ThemeToggle />
  </div>

  <article>
    <p class="year">{data.year}</p>
    <h1>{data.title}</h1>
    <p class="tagline">{data.tagline}</p>

    {data.tech.length > 0 && (
      <ul class="stack" aria-label="Tech stack">
        {data.tech.map((t) => <li>{t}</li>)}
      </ul>
    )}

    <div class="links">
      {data.liveUrl && <a href={data.liveUrl} class="link icon-link" rel="noopener">live <ArrowUpRight {...ICON_PROPS.inline} /></a>}
      {data.githubUrl && <a href={data.githubUrl} class="link icon-link" rel="noopener">github <ArrowUpRight {...ICON_PROPS.inline} /></a>}
    </div>

    <div class="body">
      <Content />
    </div>
  </article>

  <Footer />
</Base>

<style>
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 56px;
  }
  .back {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .back:hover { color: var(--accent); }

  .year {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--muted);
    margin-bottom: 10px;
  }
  h1 {
    font-size: 44px;
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin-bottom: 12px;
  }
  .tagline {
    font-size: 18px;
    color: var(--muted);
    max-width: 540px;
    margin-bottom: 32px;
  }

  .stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }
  .stack li {
    font-family: var(--font-mono);
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    border: 1px solid var(--faint);
    padding: 4px 10px;
    border-radius: 999px;
  }

  .links { display: flex; gap: 16px; margin-bottom: 48px; }
  .link {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--accent);
    border-bottom: 1px solid var(--faint);
    padding-bottom: 2px;
  }
  .link:hover { border-color: var(--accent); }


  /* Project bodies are markdown bullet lists. */
  .body :global(ul) {
    list-style: none;
    margin-top: 8px;
  }
  .body :global(li) {
    padding: 12px 0 12px 20px;
    border-bottom: 1px solid var(--faint);
    font-size: 15.5px;
    line-height: 1.55;
    position: relative;
  }
  .body :global(p) {
    font-size: 15.5px;
    line-height: 1.65;
    margin-bottom: 16px;
  }
  .body :global(li)::before {
    content: "·";
    color: var(--accent);
    position: absolute;
    left: 4px;
    top: 12px;
    font-size: 18px;
  }
</style>
