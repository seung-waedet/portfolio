---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RowList from "../../components/RowList.astro";
import { SITE, pageTitle } from "../../site.config";
import { getProjects, projectRow } from "../../lib/content";

const rows = (await getProjects()).map(projectRow);
---

<Base title={pageTitle("Projects")}>
  <Header intro={SITE.intro.projects} />

  <section>
    <h2>projects</h2>
    <RowList rows={rows} />
  </section>

  <Footer />
</Base>
